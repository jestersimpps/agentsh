[
  {
    "name": "js.scripts lists package.json scripts",
    "files": {
      "package.json": "{\"scripts\": {\"test\": \"vitest run\", \"build\": \"tsc -b\"}}",
      "apps/web/package.json": "{\"scripts\": {\"dev\": \"next dev\"}}",
      "empty/package.json": "{}"
    },
    "steps": [
      {
        "run": "js.scripts",
        "expect": {
          "value": [
            {
              "name": "test",
              "cmd": "vitest run"
            },
            {
              "name": "build",
              "cmd": "tsc -b"
            }
          ]
        }
      },
      {
        "run": "js.scripts \"apps/web/package.json\" | pick .cmd",
        "expect": {
          "value": [
            {
              "cmd": "next dev"
            }
          ]
        }
      },
      {
        "run": "js.scripts \"empty/package.json\"",
        "expect": {
          "value": []
        }
      },
      {
        "run": "js.scripts \"nope.json\"",
        "expect": {
          "error.code": "not_found"
        }
      }
    ]
  },
  {
    "name": "check picks the package manager from the lockfile",
    "files": {
      "package.json": "{\"scripts\": {\"lint\": \"eslint .\"}}",
      "pnpm-lock.yaml": ""
    },
    "steps": [
      {
        "run": "check \"lint\"",
        "expect": {
          "error.code": "capability_denied"
        }
      }
    ]
  },
  {
    "name": "js.typecheck parses tsc output into a table",
    "files": {
      "tsc.txt": "src/a.ts(3,7): error TS2322: Type 'string' is not assignable to type 'number'.\nsrc/b.ts(10,1): error TS2304: Cannot find name 'foo'.\nFound 2 errors.\n",
      "clean.txt": ""
    },
    "steps": [
      {
        "run": "read \"tsc.txt\" | js.typecheck",
        "expect": {
          "value": [
            {
              "file": "src/a.ts",
              "line": 3,
              "col": 7,
              "code": "TS2322",
              "message": "Type 'string' is not assignable to type 'number'."
            },
            {
              "file": "src/b.ts",
              "line": 10,
              "col": 1,
              "code": "TS2304",
              "message": "Cannot find name 'foo'."
            }
          ]
        }
      },
      {
        "run": "js.typecheck output:\"\"",
        "expect": {
          "value": "no type errors"
        }
      }
    ]
  },
  {
    "name": "js.typecheck without TypeScript fails fast with a hint",
    "allow": [
      "exec"
    ],
    "files": {
      "package.json": "{}"
    },
    "steps": [
      {
        "run": "js.typecheck",
        "expect": {
          "error.code": "expectation_failed",
          "error.message": "no TypeScript in node_modules/.bin"
        }
      }
    ]
  }
]
